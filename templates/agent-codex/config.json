{
  "agent_name": "{{agent_name}}",
  "enabled": true,
  "runtime": "codex-app-server",
  "model": "gpt-5-codex",
  "startup_delay": 0,
  "max_session_seconds": 255600,
  "max_crashes_per_day": 10,
  "ctx_warning_threshold": 70,
  "ctx_handoff_threshold": 80,
  "working_directory": "",
  "timezone": "",
  "shift_schedule": {
    "weekly": {
      "mon": {
        "start": "08:00",
        "end": "22:00"
      },
      "tue": {
        "start": "08:00",
        "end": "22:00"
      },
      "wed": {
        "start": "08:00",
        "end": "22:00"
      },
      "thu": {
        "start": "08:00",
        "end": "22:00"
      },
      "fri": {
        "start": "08:00",
        "end": "22:00"
      },
      "sat": {
        "start": "08:00",
        "end": "21:00"
      },
      "sun": {
        "start": "08:00",
        "end": "21:00"
      }
    }
  },
  "crons": [
    {
      "name": "heartbeat",
      "type": "recurring",
      "interval": "4h",
      "prompt": "Read HEARTBEAT.md and follow its instructions. Update your heartbeat, check inbox, and work on your highest priority task."
    }
  ]
}
